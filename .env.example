# ---------------------------------------------------------------------------
# RAG pipeline settings. Copy to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto

# --- Vector store ---
# chroma (default, local, no server) | pgvector (PostgreSQL + pgvector extension)
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_DIR=./data/vectorstore
VECTOR_DIMENSION=384
EMBEDDING_VERSION=1

# --- Database (document store; pgvector vectors also live here) ---
# SQLite (default):            DATABASE_URL=sqlite:///./data/rag.db
# PostgreSQL + pgvector:       DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
#   (VECTOR_STORE_BACKEND must be pgvector and the "vector" extension enabled.
#    docker-compose.yml provides a ready postgres:pgvector service.)
DATABASE_URL=sqlite:///./data/rag.db

# --- Document sources / limits ---
DATA_DIR=./data
MAX_FILE_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,txt,md

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval ---
RETRIEVAL_TOP_K=10
SEMANTIC_TOP_K=10
BM25_TOP_K=20
RERANK_TOP_K=5
HYBRID_FUSION=rrf
FUSION_WEIGHT_SEMANTIC=0.5
RRF_K=60
RRF_WEIGHT_SEMANTIC=1.0
RRF_WEIGHT_LEXICAL=1.0

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
RERANKER_BATCH_SIZE=16

# --- LLM ---
LLM_PROVIDER=echo
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
MAX_QUERY_LENGTH=1000
MAX_PDF_PAGES=2000

# --- Auth (multi-user documents) ---
# Secret used to sign bearer tokens. MUST be changed to a long random value in
# any non-local deployment (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
AUTH_SECRET_KEY=dev-only-change-me
AUTH_TOKEN_TTL_SECONDS=86400

# --- Caching ---
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=4096

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Context ---
CONTEXT_MAX_CHARS=8000

# --- Evaluation ---
EVAL_TOP_KS=1,5,10
