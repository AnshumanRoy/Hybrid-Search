# ---------------------------------------------------------------------------
# RAG pipeline settings. Copy to `.env` and adjust as needed.
# ---------------------------------------------------------------------------

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto

# --- Vector store ---
# chroma (default, local, no server) | pgvector (PostgreSQL + pgvector extension)
VECTOR_STORE_BACKEND=chroma
VECTOR_STORE_DIR=./data/vectorstore
VECTOR_DIMENSION=384
EMBEDDING_VERSION=1

# --- Database (document store; pgvector vectors also live here) ---
# SQLite (default):            DATABASE_URL=sqlite:///./data/rag.db
# PostgreSQL + pgvector:       DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
#   (VECTOR_STORE_BACKEND must be pgvector and the "vector" extension enabled.
#    docker-compose.yml provides a ready postgres:pgvector service.)
DATABASE_URL=sqlite:///./data/rag.db

# --- Document sources / limits ---
DATA_DIR=./data
MAX_FILE_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,txt,md

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# --- Retrieval ---
RETRIEVAL_TOP_K=10
SEMANTIC_TOP_K=10
BM25_TOP_K=20
RERANK_TOP_K=5
HYBRID_FUSION=rrf
FUSION_WEIGHT_SEMANTIC=0.5
RRF_K=60
RRF_WEIGHT_SEMANTIC=1.0
RRF_WEIGHT_LEXICAL=1.0

# --- Reranker ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true
RERANKER_BATCH_SIZE=16

# --- LLM ---
LLM_PROVIDER=echo
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=512
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=

# --- Nemotron (NVIDIA NIM) ---
# Registering nemotron makes it selectable per /query via {"model": "nemotron"}
# (the default provider is still governed by LLM_PROVIDER).
#   NEMOTRON_ENABLED=true   -> register nemotron as an optional backend
#   LLM_PROVIDER=nemotron   -> use nemotron as the default backend (implies enabled)
# Requires a key from https://build.nvidia.com (not shown in /docs).
NVIDIA_API_KEY=
NEMOTRON_ENABLED=false
# Hosted NIM; point at any self-hosted NIM/OpenAI-compatible base URL to override.
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_MAX_TOKENS=512
NEMOTRON_TIMEOUT_SECONDS=60
NEMOTRON_MAX_RETRIES=3
NEMOTRON_ENABLE_THINKING=false

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
MAX_QUERY_LENGTH=1000
MAX_PDF_PAGES=2000

# --- Auth (multi-user documents) ---
# Secret used to sign JWT access tokens. MUST be changed to a long random value
# in any non-local deployment (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
AUTH_SECRET_KEY=dev-only-change-me
# Access-token lifetime (seconds). Keep short; clients re-issue via
# POST /auth/refresh before expiry. Revocation via POST /auth/revoke (bumps a
# per-user token_version that is embedded as the `ver` claim).
AUTH_TOKEN_TTL_SECONDS=900

# --- Rate limiting (per-user, /query + /rewrite) ---
# Cost guardrail for the LLM/NIM bill; backed by the shared cache. Fails open
# when the cache is unavailable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_DAILY_MAX_REQUESTS=2000

# --- Caching ---
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=4096
# Backend for the LLM-response + rewrite caches: "memory" (bounded in-process
# TTL dict) or "redis" (shared across replicas; fails open if unreachable).
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
CACHE_REDIS_URL=redis://localhost:6379/0
# Vector-store caching is a separate layer (opt-in, correctness comes from the
# per-collection generation counter). See VECTOR_CACHE_*.

# --- Query rewriting (multi-query expansion, orchestrator-facing) ---
# QUERY_REWRITE_ENABLED gates automatic rewriting inside /query. The standalone
# /rewrite endpoint works regardless of this flag.
QUERY_REWRITE_ENABLED=false
# "llm" | "heuristic" — which rewriter /query and /rewrite default to.
QUERY_REWRITE_STRATEGY=llm
# Default number of retrieval variants (clamped to MAX_REWRITE_VARIANTS=10).
REWRITE_MAX_VARIANTS=3
# LLM backend used for the llm strategy.
REWRITE_LLM_MODEL=nemotron
# Per-request timeout for the rewrite LLM call (seconds).
REWRITE_TIMEOUT_SECONDS=15.0

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Context ---
CONTEXT_MAX_CHARS=8000

# --- Evaluation ---
EVAL_TOP_KS=1,5,10
